{
  // Coffee Atlas API — Cloudflare Worker
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffee-atlas-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // 真实资源（已创建）：
  //   D1: coffee-atlas-db
  //   R2: coffee-atlas-imgs（部署前需在 Dashboard 开通 R2）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coffee-atlas-db",
      "database_id": "a8d94ea0-2f32-47ca-81b6-64dca2eee082",
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "coffee-atlas-imgs",
    },
  ],

  // 写接口速率限制器（Durable Objects）
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"],
    },
  ],
}
